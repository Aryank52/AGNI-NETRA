# ==============================================================================
# AGNI-NETRA — Frontend Environment Variables Template
# ==============================================================================

# Production or Staging Backend API Base URL (Must point to FastAPI /api/v1)
# For local development: http://localhost:8000/api/v1
# For Render production: https://agni-netra-api.onrender.com/api/v1 (or custom domain)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# MapLibre / Mapbox Token (Optional: Empty uses OpenStreetMap Carto tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=

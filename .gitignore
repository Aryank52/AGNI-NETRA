# ==============================================================================
# AGNI-NETRA .gitignore
# ==============================================================================

# Python & Virtual Environments
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets (Preserve .env.example templates)
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
frontend/.env.local
backend/.env
deployment/.env
!.env.example
!**/.env.example
!deployment/.env.example
!frontend/.env.example

# Credentials, Keys, and Private Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secrets
secrets.*
credentials.json
service_account*.json

# Local SQLite databases & local caches
*.db
*.sqlite
*.sqlite3
*.dump
agni_netra.db
storage_cache/
backend/app/cache/
artifacts/
database/backups/

# Local Project Archive & Historical Preservation
LOCAL_PROJECT_ARCHIVE/

# Local Development Scratch & Diagnostic Workspaces
scratch/

# Local Runtime Backups & Generated Report Artifacts
backups/
reports/
STRESS_TEST_RESULTS.json

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

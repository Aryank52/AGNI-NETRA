# Python & Virtual Environments
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets (Preserve .env.example)
.env
.env.*
!.env.example
deployment/.env
!deployment/.env.example

# Local SQLite databases & local caches
*.sqlite
*.sqlite3
agni_netra.db
storage_cache/

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ==============================================================================
# AGNI-NETRA Environment Configuration
# AI Geospatial Network for Industrial Thermal Risk & Anomaly Analysis
# ==============================================================================

# Project & Environment
PROJECT_NAME=AGNI-NETRA
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=agni_netra_secret_key_change_in_production_2026_super_secure_key_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with PostGIS / SQLite Spatial Engine Fallback)
# For local standalone / demo mode: sqlite:///./agni_netra.db
# For PostgreSQL with PostGIS: postgresql+psycopg2://postgres:postgres@localhost:5432/agni_netra
DATABASE_URL=sqlite:///./agni_netra.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agni_netra
POSTGRES_PORT=5432

# Redis & Async Tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_REPORTS=agni-netra-reports
S3_BUCKET_IMAGERY=agni-netra-imagery

# External Geospatial / Remote Sensing APIs (Optional - Demo fallback provided)
FIRMS_MAP_KEY=
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Model Management
MODEL_DIR=ml/models
DEFAULT_MODEL_VERSION=v1.0.0

# CORS & Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ==============================================================================
# AGNI-NETRA Environment Configuration (Root Example)
# AI Geospatial Network for Industrial Thermal Risk & Anomaly Analysis
# ==============================================================================

# Project & Environment
PROJECT_NAME=AGNI-NETRA
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
SECRET_KEY=replace_with_cryptographically_secure_jwt_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Primary Database Configuration: PostgreSQL 16 + PostGIS 3.4
# (Fallback: For zero-dependency local isolated test/demo: sqlite:///./agni_netra.db)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agni_netra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agni_netra
POSTGRES_PORT=5432

# Redis & Async Tasks (Celery Message Broker & Caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (S3 / MinIO for Satellite Imagery & PDF Dossiers)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agni-netra
S3_BUCKET_REPORTS=agni-netra-reports
S3_BUCKET_IMAGERY=agni-netra-imagery

# External Geospatial / Remote Sensing APIs (Optional)
FIRMS_MAP_KEY=
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Notifications & Alerts (Optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@agni-netra.gov.in
SMS_ENABLED=false
SMS_PROVIDER=CONSOLE
SMS_API_KEY=

# Model Management
MODEL_DIR=ml/models
DEFAULT_MODEL_VERSION=v1.0.0

# CORS & Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
